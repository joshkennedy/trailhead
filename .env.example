# =============================================================================
# Trailhead — Environment Variables
# Copy to .env and fill in your values for local development.
# Never commit .env to version control.
# =============================================================================

# Rails
RAILS_MASTER_KEY=           # contents of config/master.key
SECRET_KEY_BASE=            # generate with: bundle exec rails secret
HOST=localhost:3000         # production: your domain

# Database (Railway auto-provides DATABASE_URL)
DATABASE_URL=postgres://localhost/trailhead_development

# Stripe (Pay gem)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Error tracking
HONEYBADGER_API_KEY=

# Email (Resend recommended)
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=hello@yourdomain.com
