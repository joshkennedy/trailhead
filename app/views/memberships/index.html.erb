<% content_for(:title) { "Team — #{@account.name}" } %>

<div class="space-y-6">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Team</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @account.name %></p>
    </div>
  </div>

  <%# Invite form (admins only) %>
  <% if current_user.admin_of?(@account) %>
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-medium mb-4">Invite Member</h3>
      <%= form_with(url: account_memberships_path(@account), method: :post, class: "flex gap-4 items-end") do |f| %>
        <div class="flex-1">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, placeholder: "colleague@company.com",
              class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.select :role, Membership::ROLES.reject { |r| r == "owner" }.map { |r| [r.titleize, r] },
              {}, class: "rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
        </div>
        <%= f.submit "Invite", class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 cursor-pointer text-sm font-medium" %>
      <% end %>
    </div>
  <% end %>

  <%# Members list %>
  <div class="bg-white shadow rounded-lg divide-y">
    <% @memberships.each do |membership| %>
      <div class="p-4 flex justify-between items-center">
        <div>
          <p class="font-medium text-gray-900"><%= membership.user.name %></p>
          <p class="text-sm text-gray-500"><%= membership.user.email %></p>
        </div>
        <div class="flex items-center gap-3">
          <%# Status badge %>
          <% unless membership.active? %>
            <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-amber-100 text-amber-800">
              <%= membership.status.titleize %>
            </span>
          <% end %>

          <%# Role badge %>
          <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium
            <%= case membership.role
                when 'owner' then 'bg-purple-100 text-purple-800'
                when 'admin' then 'bg-blue-100 text-blue-800'
                else 'bg-gray-100 text-gray-800'
                end %>">
            <%= membership.role.titleize %>
          </span>

          <%# Actions (admin only, not for owners) %>
          <% if current_user.admin_of?(@account) && !membership.owner? && membership.user != current_user %>
            <%= button_to "Remove", account_membership_path(@account, membership),
                method: :delete, class: "text-sm text-red-600 hover:text-red-800",
                data: { turbo_confirm: "Remove #{membership.user.name} from #{@account.name}?" } %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
