<% content_for(:title) { "Billing — #{@account.name}" } %>

<div class="space-y-8">
  <div>
    <h1 class="text-3xl font-bold text-gray-900">Billing</h1>
    <p class="text-sm text-gray-500 mt-1"><%= @account.name %></p>
  </div>

  <%# Current subscription status %>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Current Subscription</h2>
    <% if @subscriptions.active.any? %>
      <% sub = @subscriptions.active.first %>
      <p class="text-3xl font-bold text-indigo-600"><%= sub.processor_plan %></p>
      <p class="text-sm text-gray-500 mt-1">Status: <%= sub.status.titleize %></p>
    <% else %>
      <p class="text-2xl font-bold text-gray-400">No active subscription</p>
    <% end %>
  </div>

  <%# Available plans %>
  <div>
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Available Plans</h2>
    <div class="grid gap-6 sm:grid-cols-3">
      <% @plans.each do |plan| %>
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-xl font-bold text-gray-900"><%= plan.name %></h3>
          <p class="text-3xl font-bold text-indigo-600 mt-2"><%= plan.formatted_price %></p>
          <p class="text-sm text-gray-500 mt-1">Up to <%= plan.seat_limit %> members</p>

          <ul class="mt-4 space-y-2 text-sm text-gray-600">
            <% plan.features.each do |feature, enabled| %>
              <li class="flex items-center">
                <% if enabled %>
                  <svg class="w-4 h-4 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                <% else %>
                  <svg class="w-4 h-4 text-gray-300 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                <% end %>
                <%= feature.titleize.gsub("_", " ") %>
              </li>
            <% end %>
          </ul>

          <% if plan.stripe_price_id.present? %>
            <%= button_to "Subscribe", billing_checkout_path(plan: plan.slug),
                class: "mt-6 w-full px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 text-sm font-medium" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Stripe Portal link %>
  <% if @payment_processor&.processor_id.present? %>
    <div class="text-center">
      <%= link_to "Manage Billing in Stripe →", billing_portal_path,
          class: "text-indigo-600 hover:text-indigo-800 font-medium" %>
    </div>
  <% end %>

  <%# Recent charges %>
  <% if @charges.any? %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <h2 class="text-lg font-semibold text-gray-800 p-6 pb-3">Recent Charges</h2>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @charges.each do |charge| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-900"><%= charge.created_at.strftime("%b %d, %Y") %></td>
              <td class="px-6 py-4 text-sm text-gray-900"><%= number_to_currency(charge.amount / 100.0) %></td>
              <td class="px-6 py-4 text-sm capitalize"><%= charge.data&.dig("status") || "succeeded" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
