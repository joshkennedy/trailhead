<%= form_with(model: account, class: "space-y-6") do |form| %>
  <% if account.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4">
      <h2 class="text-sm font-medium text-red-800"><%= pluralize(account.errors.count, "error") %> prevented saving:</h2>
      <ul class="mt-2 list-disc list-inside text-sm text-red-700">
        <% account.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm", required: true %>
  </div>

  <div>
    <%= form.label :billing_email, class: "block text-sm font-medium text-gray-700" %>
    <%= form.email_field :billing_email, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.label :tax_id, "Tax ID (optional)", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :tax_id, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
  </div>

  <div>
    <%= form.submit class: "w-full px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 cursor-pointer font-medium" %>
  </div>
<% end %>
